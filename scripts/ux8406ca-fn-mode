#!/bin/bash

set -u

readonly keyboard_vendor="0b05"
readonly keyboard_product="1bf2"
readonly bluetooth_product="1BF3"
readonly config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/ux8406ca-linux"
readonly config_file="$config_dir/fn-mode"
readonly backlight_file="$config_dir/keyboard-backlight"
readonly helper="${UX8406CA_FN_HELPER:-$HOME/.local/libexec/ux8406ca-fn-send}"
readonly display_brightness_helper="${UX8406CA_DISPLAY_BRIGHTNESS_HELPER:-$HOME/.local/bin/omarchy-brightness-display}"
readonly runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
readonly lock_file="$runtime_dir/ux8406ca-fn-mode.lock"
readonly pid_file="$runtime_dir/ux8406ca-fn-mode.pid"

log() {
  printf 'ux8406ca-fn-mode: %s\n' "$*"
}

keyboard_is_docked() {
  local device

  for device in /sys/bus/usb/devices/*; do
    [[ -r "$device/idVendor" && -r "$device/idProduct" ]] || continue
    [[ "$(<"$device/idVendor")" == "$keyboard_vendor" &&
       "$(<"$device/idProduct")" == "$keyboard_product" ]] && return 0
  done
  return 1
}

keyboard_is_bluetooth() {
  local device
  for device in /sys/bus/hid/devices/0005:0B05:"$bluetooth_product".*; do
    [[ -e "$device" ]] && return 0
  done
  return 1
}

keyboard_is_available() {
  keyboard_is_docked || keyboard_is_bluetooth
}

configured_mode() {
  local mode="media"

  if [[ -r "$config_file" ]]; then
    read -r mode <"$config_file"
  fi
  case "$mode" in
    media|function) printf '%s\n' "$mode" ;;
    *)
      log "invalid mode in $config_file; using media" >&2
      printf 'media\n'
      ;;
  esac
}

save_mode() {
  local mode="$1" temp
  mkdir -p "$config_dir"
  temp="$(mktemp "$config_dir/fn-mode.XXXXXX")"
  printf '%s\n' "$mode" >"$temp"
  chmod 0600 "$temp"
  mv -f -- "$temp" "$config_file"
}

configured_backlight() {
  local level="1"
  if [[ -r "$backlight_file" ]]; then
    read -r level <"$backlight_file"
  fi
  case "$level" in
    0|1|2|3) printf '%s\n' "$level" ;;
    *)
      log "invalid level in $backlight_file; using 1" >&2
      printf '1\n'
      ;;
  esac
}

save_backlight() {
  local level="$1" temp
  mkdir -p "$config_dir"
  temp="$(mktemp "$config_dir/keyboard-backlight.XXXXXX")"
  printf '%s\n' "$level" >"$temp"
  chmod 0600 "$temp"
  mv -f -- "$temp" "$backlight_file"
}

show_backlight_osd() {
  local level="$1"
  command -v omarchy-osd >/dev/null 2>&1 || return 0
  omarchy-osd -i keyboard -p "$(( level * 100 / 3 ))" >/dev/null 2>&1 || true
}

apply_backlight() {
  local level
  level="$(configured_backlight)"
  if ! keyboard_is_available; then
    log "keyboard is disconnected; saved backlight level $level will apply when connected"
    return 0
  fi
  [[ -x "$helper" ]] || { log "missing helper: $helper" >&2; return 1; }
  "$helper" backlight "$level"
}

set_backlight() {
  local level="$1"
  save_backlight "$level"
  apply_backlight && show_backlight_osd "$level"
}

cycle_backlight() {
  local level
  level="$(configured_backlight)"
  level=$(( (level + 1) % 4 ))
  set_backlight "$level"
}

adjust_display_brightness() {
  local direction="$1" step monitor
  [[ -x "$display_brightness_helper" ]] || {
    log "missing display brightness helper: $display_brightness_helper" >&2
    return 1
  }
  case "$direction" in
    down) step="5%-" ;;
    up) step="+5%" ;;
    *) return 2 ;;
  esac
  monitor="$(omarchy-hyprland-monitor-focused 2>/dev/null || true)"
  if [[ -n "$monitor" ]]; then
    "$display_brightness_helper" --monitor "$monitor" "$step"
  else
    "$display_brightness_helper" "$step"
  fi || {
    log "failed to adjust focused-display brightness $direction" >&2
    return 1
  }
}

apply_mode() {
  local mode
  mode="$(configured_mode)"
  if ! keyboard_is_available; then
    log "keyboard is disconnected; saved $mode-default mode will apply when connected"
    return 0
  fi
  [[ -x "$helper" ]] || { log "missing helper: $helper" >&2; return 1; }
  "$helper" "$mode"
}

set_mode() {
  local mode="$1"
  save_mode "$mode"
  apply_mode
}

wait_for_device_add() {
  local action=""

  while IFS= read -r line; do
    case "$line" in
      ACTION=*) action="${line#ACTION=}" ;;
      "")
        if [[ "$action" == "add" ]]; then
          return 0
        fi
        action=""
        ;;
    esac
  done < <(stdbuf -oL udevadm monitor --udev --property 9>&- 2>/dev/null)
}

watch_events() {
  local event

  exec 9>"$lock_file"
  if ! flock -n 9; then
    log "another monitor instance is already running"
    return 0
  fi
  printf '%s\n' "$$" >"$pid_file"
  trap 'rm -f -- "$pid_file"' EXIT
  trap 'exit 0' INT TERM

  while true; do
    if keyboard_is_available; then
      apply_mode || log "apply failed"
      apply_backlight || log "keyboard backlight restore failed"
      while IFS= read -r event; do
        case "$event" in
          toggle)
            if [[ "$(configured_mode)" == "media" ]]; then
              set_mode function
            else
              set_mode media
            fi
            ;;
          backlight) cycle_backlight ;;
          brightness-down) adjust_display_brightness down ;;
          brightness-up) adjust_display_brightness up ;;
        esac
      done < <("$helper" listen)
      log "Fn listener stopped; waiting for keyboard connection"
    fi
    wait_for_device_add
    sleep 0.4
  done
}

case "${1:-}" in
  media|function) set_mode "$1" ;;
  toggle)
    if [[ "$(configured_mode)" == "media" ]]; then set_mode function; else set_mode media; fi
    ;;
  apply) apply_mode ;;
  backlight)
    case "${2:-}" in
      0|1|2|3) set_backlight "$2" ;;
      cycle) cycle_backlight ;;
      apply) apply_backlight ;;
      status) printf 'level=%s\n' "$(configured_backlight)" ;;
      *) printf 'Usage: %s backlight 0|1|2|3|cycle|apply|status\n' "${0##*/}" >&2; exit 2 ;;
    esac
    ;;
  status)
    printf 'configured=%s\n' "$(configured_mode)"
    if keyboard_is_docked; then
      printf 'transport=usb-docked\n'
    elif keyboard_is_bluetooth; then
      printf 'transport=bluetooth\n'
    else
      printf 'transport=disconnected\n'
    fi
    ;;
  --watch) watch_events ;;
  *)
    printf 'Usage: %s media|function|toggle|apply|status|backlight ...|--watch\n' "${0##*/}" >&2
    exit 2
    ;;
esac
